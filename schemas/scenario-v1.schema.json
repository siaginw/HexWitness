{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/siaginw/HexWitness/main/schemas/scenario-v1.schema.json",
  "title": "HexWitness controlled capture scenario",
  "type": "object",
  "required": ["schema", "id", "title", "required_roles", "steps"],
  "properties": {
    "schema": { "const": "hexwitness-scenario-v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "maximum_duration_seconds": { "type": "integer", "minimum": 1 },
    "required_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "instruction"], "properties": {
      "id": { "type": "string" }, "instruction": { "type": "string" }, "required": { "type": "boolean" }, "wait_after_seconds": { "type": "number", "minimum": 0 }
    } } }
  },
  "additionalProperties": false
}
