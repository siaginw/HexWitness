{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/siaginw/HexWitness/main/schemas/capture-pack-v1.schema.json",
  "title": "HexWitness capture pack manifest",
  "type": "object",
  "required": ["schema", "capture_id", "scenario", "status", "build_id", "started_utc", "required_roles", "artifacts", "markers"],
  "properties": {
    "schema": { "const": "hexwitness-capture-pack-v1" },
    "schema_version": { "const": 1 },
    "capture_id": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "status": { "enum": ["active", "sealed"] },
    "quality": { "enum": ["pending", "accepted", "incomplete"] },
    "build_id": { "type": ["string", "null"] },
    "executable_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": ["string", "null"], "format": "date-time" },
    "required_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_markers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "context": { "type": "object" },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "markers": { "type": "array", "items": { "$ref": "#/$defs/marker" } },
    "quality_report": { "type": "object" }
  },
  "$defs": {
    "artifact": { "type": "object", "required": ["role", "path", "sha256", "size_bytes"], "properties": {
      "role": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
      "size_bytes": { "type": "integer", "minimum": 0 }, "media_type": { "type": "string" }, "event_count": { "type": ["integer", "null"] }
    } },
    "marker": { "type": "object", "required": ["ordinal", "ts_utc", "name"], "properties": {
      "ordinal": { "type": "integer", "minimum": 1 }, "ts_utc": { "type": "string", "format": "date-time" },
      "name": { "type": "string" }, "note": { "type": ["string", "null"] }, "metadata": { "type": "object" }
    } }
  },
  "additionalProperties": true
}
