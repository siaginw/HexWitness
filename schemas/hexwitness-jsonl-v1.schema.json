{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/siaginw/HexWitness/main/schemas/hexwitness-jsonl-v1.schema.json",
  "title": "HexWitness JSONL record",
  "description": "One newline-delimited record in the HexWitness evidence interchange format.",
  "type": "object",
  "required": ["format", "record"],
  "properties": {
    "format": { "const": "hexwitness-jsonl-v1" },
    "record": {
      "enum": ["build", "artifact", "entity", "edge", "evidence", "claim", "capture", "event"]
    },
    "build_id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "record": { "const": "build" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "architecture": { "type": "string" },
          "image_base": { "$ref": "#/$defs/address" },
          "tool": { "type": "string" },
          "tool_version": { "type": "string" },
          "created_utc": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "artifact" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "role"],
        "properties": {
          "artifact_id": { "type": "string" },
          "role": { "type": "string", "minLength": 1 },
          "path_hint": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "entity" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "kind", "stable_key"],
        "properties": {
          "entity_id": { "type": "string" },
          "kind": {
            "enum": ["function", "symbol", "string", "type", "class", "field", "global", "import", "export", "basic_block", "runtime_object", "protocol_message", "other"]
          },
          "stable_key": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "address": { "$ref": "#/$defs/address" },
          "size": { "type": "integer", "minimum": 0 },
          "namespace": { "type": "string" },
          "signature": { "type": "string" },
          "decompiler": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "edge" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "kind", "source", "target"],
        "properties": {
          "edge_id": { "type": "string" },
          "kind": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "source_address": { "$ref": "#/$defs/address" },
          "target_address": { "$ref": "#/$defs/address" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "evidence" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "source", "source_ref", "summary"],
        "properties": {
          "evidence_id": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "observed_utc": { "$ref": "#/$defs/timestamp" },
          "confidence": { "$ref": "#/$defs/confidence" },
          "classification": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "payload_sha256": { "$ref": "#/$defs/sha256" },
          "entities": { "type": "array", "items": { "type": "string" } },
          "relation": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "claim" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "subject", "predicate", "object"],
        "properties": {
          "claim_id": { "type": "string" },
          "subject": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "confidence": { "$ref": "#/$defs/confidence" },
          "created_utc": { "$ref": "#/$defs/timestamp" },
          "updated_utc": { "$ref": "#/$defs/timestamp" },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "stance": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "capture" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "capture_id", "scenario"],
        "properties": {
          "capture_id": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "started_utc": { "$ref": "#/$defs/timestamp" },
          "finished_utc": { "$ref": "#/$defs/timestamp" },
          "status": { "type": "string" },
          "manifest_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "record": { "const": "event" } }, "required": ["record"] },
      "then": {
        "required": ["build_id", "capture_id", "ordinal", "source", "kind", "name"],
        "properties": {
          "event_id": { "type": "string" },
          "capture_id": { "type": "string", "minLength": 1 },
          "ordinal": { "type": "integer", "minimum": 0 },
          "ts_utc": { "$ref": "#/$defs/timestamp" },
          "source": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "direction": { "type": "string" },
          "address": { "$ref": "#/$defs/address" },
          "thread_id": { "type": ["string", "integer"] },
          "body_len": { "type": "integer", "minimum": 0 },
          "body_sha256": { "$ref": "#/$defs/sha256" },
          "confidence": { "$ref": "#/$defs/confidence" },
          "action_id": { "type": ["string", "integer"] },
          "summary": { "type": "string" },
          "fields": { "type": "object" }
        }
      }
    }
  ],
  "$defs": {
    "address": {
      "description": "Prefer a canonical hexadecimal string. Safe JSON integers remain accepted for compatibility.",
      "oneOf": [
        { "type": "string", "pattern": "^0[xX][0-9a-fA-F]+$" },
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
