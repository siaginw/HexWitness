{
  "mcpServers": {
    "hexwitness": {
      "command": "node",
      "args": ["C:/path/to/HexWitness/bin/hexwitness-agent.mjs"],
      "env": {
        "HEXWITNESS_AGENT_SESSION": "replace-with-project-name"
      }
    },
    "binary_ninja_live": {
      "url": "http://127.0.0.1:9090/mcp"
    },
    "ida_live": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "C:/tools/ida-pro-mcp",
        "idalib-mcp",
        "--stdio"
      ]
    }
  }
}
